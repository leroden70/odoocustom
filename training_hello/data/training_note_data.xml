<odoo noupdate="1">
    <record id="training_note_welcome" model="training.note">
        <field name="title">Bienvenue</field>
        <field name="body">Une note est un enregistrement stocké par Odoo.</field>
    </record>
    <record id="training_note_observe" model="training.note">
        <field name="title">Observer avant de modifier</field>
