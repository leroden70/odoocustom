<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <template id="formations_page" name="Liste des formations">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <main class="container py-5">
          <header class="mb-4">
            <h1>Formations à découvrir</h1>
            <p>Choisissez une formation pour voir son contenu.</p>
          </header>
          <div class="row g-3">
            <article t-foreach="modules" t-as="module" class="col-12 col-md-6">
              <div class="h-100 p-3 border rounded">
                <h2 class="h4" t-out="module.name"/>
                <p t-if="module.description" t-out="module.description"/>
                <a class="btn btn-outline-primary"
                   t-attf-href="/formations/{{ module.id }}">
                  Voir cette formation
                </a>
              </div>
            </article>
          </div>
        </main>
      </div>
    </t>
  </template>

  <template id="formation_detail_page" name="Détail d’une formation">
    <t t-call="website.layout">
      <div id="wrap" class="oe_structure">
        <main class="container py-5">
          <p><a href="/formations">← Toutes les formations</a></p>
          <h1 t-out="module.name"/>
          <p t-if="module.description" t-out="module.description"/>
          <section class="mt-5" aria-labelledby="notes-title">
            <h2 id="notes-title">Notes associées</h2>
            <p t-if="not module.note_ids">Aucune note n’est associée à cette formation.</p>
            <article t-foreach="module.note_ids" t-as="note" class="mb-3 p-3 border rounded">
              <h3 class="h5" t-out="note.title"/>
              <p t-if="note.category_id" class="text-muted" t-out="note.category_id.name"/>
              <p t-if="note.body" t-out="note.body"/>
            </article>
          </section>
        </main>
      </div>
    </t>
  </template>
</odoo>