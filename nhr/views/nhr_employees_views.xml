<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="nhr.employees_view_search" model="ir.ui.view">
        <field name="name">nhr.employees.search</field>
        <field name="model">nhr.employees</field>
        <field name="arch" type="xml">
            <search>
                <field name="first_name"/>
                <field name="last_name"/>
            </search>
        </field>
    </record>

    <record id="nhr_employees_view_form_v2" model="ir.ui.view">
        <field name="name">nhr.employees.form</field>
        <field name="model">nhr.employees</field>
        <field name="arch" type="xml">
            <form string="Employee">
                <sheet>
<!--                    <group>-->
<!--                        <field name="photo" widget="image" class="oe_avatar"-->
<!--                               options="{'size': [120, 120]}" nolabel="1"/>-->
<!--                    </group>-->
                    <group>
                        <field name="photo" widget="image" class="rounded float-start img-thumbnail"
                               options="{'size': [150, 150]}" nolabel="1"/>
                        <div class="oe_title">
                            <h1>
                                <field name="full_name"/>
                            </h1>
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="first_name"/>
                            <field name="last_name"/>
                            <field name="email"/>
                            <field name="phone_number"/>
                            <field name="hire_date"/>
                        </group>
                        <group>
                            <field name="job_id"/>
                            <field name="salary"/>
                            <field name="commission_pct"/>
                            <field name="manager_id"/>
                            <field name="department_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Job History">
                            <group>
                                <field name="job_history_id"/>
                            </group>
                        </page>
                        <page string="Holidays">
                            <group>
                                <field name="absences_id"/>
                            </group>
                        </page>
                        <page string="Entitlement to holidays">
                            <group>
                                <field name="ent_holidays_id"/>
                            </group>
                        </page>
                        <page string="Management Hierarchy">
                            <group>
                                <h2>Management Hierarchy</h2>
                                <field name="hierarchy_string"
                                       readonly="1"
                                       widget="html"
                                       nolabel="1"
                                       style="font-family: monospace; white-space: pre-wrap; background-color: #f8f9fa; padding: 10px; border-radius: 4px;"/>
                            </group>
                        </page>
                        <page string="Subordinates Chain">
                            <group>
                                <h2>Subordinates Chain</h2>
                                <field name="subordinates_string"
                                       readonly="1"
                                       widget="html"
                                       nolabel="1"
                                       style="font-family: monospace; white-space: pre-wrap; background-color: #f8f9fa; padding: 10px; border-radius: 4px;"/>
                            </group>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_employees_view_list_v2" model="ir.ui.view">
        <field name="name">nhr.employees.list</field>
        <field name="model">nhr.employees</field>
        <field name="arch" type="xml">
            <list string="Employees" class="o_list_table_auto" limit="20">
                <field name="full_name"/>
                <field name="email"/>
                <field name="phone_number"/>
                <field name="hire_date"/>
                <field name="job_id"/>
                <field name="salary"/>
                <field name="commission_pct"/>
                <field name="manager_id"/>
                <field name="department_id"/>
            </list>
        </field>
    </record>

    <record id="nhr_employees_action" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">nhr.employees</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>