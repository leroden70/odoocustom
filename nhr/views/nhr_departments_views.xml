<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_departments_view_list" model="ir.ui.view">
        <field name="name">nhr.departments</field>
        <field name="model">nhr.departments</field>
        <field name="arch" type="xml">
            <list string="Property Tags">
                <field name="department_name"/>
                <field name="manager_id"/>
                <field name="location_id" options="{'no_create': True}"/>
            </list>
        </field>
    </record>

    <record id="nhr_departments_view_form" model="ir.ui.view">
        <field name="name">nhr.departments</field>
        <field name="model">nhr.departments</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <group>
                        <field name="department_name"/>
                        <field name="manager_id"/>
                        <field name="location_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_departments_action" model="ir.actions.act_window">
        <field name="name">Absences</field>
        <field name="res_model">nhr.departments</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>