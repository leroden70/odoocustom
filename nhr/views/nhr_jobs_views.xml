<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_jobs_view_list" model="ir.ui.view">
        <field name="name">nhr.jobs</field>
        <field name="model">nhr.jobs</field>
        <field name="arch" type="xml">
            <list string="Jobs">
                <field name="job_title" width="30%"/>
                <field name="min_salary" width="10%"/>
                <field name="max_salary" width="10%"/>
            </list>
        </field>
    </record>

    <record id="nhr_jobs_view_form" model="ir.ui.view">
        <field name="name">nhr.jobs</field>
        <field name="model">nhr.jobs</field>
        <field name="arch" type="xml">
            <form string="Jobs">
                <sheet>
                    <group>
                        <field name="job_title"/>
                        <field name="min_salary"/>
                        <field name="max_salary"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_jobs_action" model="ir.actions.act_window">
        <field name="name">Jobs</field>
        <field name="res_model">nhr.jobs</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>