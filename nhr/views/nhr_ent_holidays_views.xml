<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_employees_view_list" model="ir.ui.view">
        <field name="name">nhr.ent_holidays</field>
        <field name="model">nhr.ent_holidays</field>
        <field name="arch" type="xml">
            <list string="Entitlement to holidays">
<!--                <field name="employee_id"/>-->
                <field name="absence_type"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="entitlement"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="nhr_employees_view_form" model="ir.ui.view">
        <field name="name">nhr.ent_holidays</field>
        <field name="model">nhr.ent_holidays</field>
        <field name="arch" type="xml">
            <form string="Entitlement to holidays">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="absence_type"/>
                        <field name="entitlement"/>
                    </group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <field name="balance"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_ent_holidays_action" model="ir.actions.act_window">
        <field name="name">Entitlemnet to holidays</field>
        <field name="res_model">nhr.ent_holidays</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>