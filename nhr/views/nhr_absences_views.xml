<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_absences_view_list" model="ir.ui.view">
        <field name="name">nhr.absences</field>
        <field name="model">nhr.absences</field>
        <field name="arch" type="xml">
            <list string="Property Tags">
                <field name="is_locked" invisible="1"/>
<!--                <field name="employee_id"/>-->
                <field name="absence_type" readonly="id"/>
                <field name="description" readonly="is_locked"/>
                <field name="start_date" readonly="is_locked"/>
                <field name="estimated_end_date" readonly="is_locked"/>
                <field name="end_date" readonly="not id or is_locked"/>
            </list>
        </field>
    </record>

    <record id="nhr_absences_view_form" model="ir.ui.view">
        <field name="name">nhr.absences</field>
        <field name="model">nhr.absences</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <field name="is_locked" invisible="1"/>
                    <group>
                        <field name="employee_id" readonly="True" force_save="1"/>
                        <field name="absence_type" readonly="id"/>
                        <field name="description" readonly="is_locked"/>
                        <field name="start_date" readonly="is_locked"/>
                        <field name="estimated_end_date" readonly="is_locked"/>
                        <field name="end_date" readonly="not id or is_locked"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_absences_action" model="ir.actions.act_window">
        <field name="name">Absences</field>
        <field name="res_model">nhr.absences</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>