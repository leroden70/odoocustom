<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_absences_view_list" model="ir.ui.view">
        <field name="name">nhr.absences</field>
        <field name="model">nhr.absences</field>
        <field name="arch" type="xml">
            <list string="Property Tags">
<!--                <field name="employee_id"/>-->
                <field name="absence_type"/>
                <field name="description"/>
                <field name="start_date"/>
                <field name="estimated_end_date"/>
                <field name="end_date"/>
            </list>
        </field>
    </record>

    <record id="nhr_absences_view_form" model="ir.ui.view">
        <field name="name">nhr.absences</field>
        <field name="model">nhr.absences</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="absence_type"/>
                        <field name="description"/>
                        <field name="start_date"/>
                        <field name="estimated_end_date"/>
                        <field name="end_date"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_absences_action" model="ir.actions.act_window">
        <field name="name">Absences</field>
        <field name="res_model">nhr.absences</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>