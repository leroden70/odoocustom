<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_public_holidays_view_list" model="ir.ui.view">
        <field name="name">nhr.public_holidays</field>
        <field name="model">nhr.public_holidays</field>
        <field name="arch" type="xml">
            <list string="Public Holidays">
                <field name="country_id"/>
                <field name="holiday_date"/>
                <field name="holiday_description"/>
            </list>
        </field>
    </record>

    <record id="nhr_public_holidays_view_form" model="ir.ui.view">
        <field name="name">nhr.public_holidays</field>
        <field name="model">nhr.public_holidays</field>
        <field name="arch" type="xml">
            <form string="Public Holidays">
                <sheet>
                    <group>
                        <field name="country_id"/>
                        <field name="holiday_date"/>
                        <field name="holiday_description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_public_holidays_action" model="ir.actions.act_window">
        <field name="name">Public Holidays</field>
        <field name="res_model">nhr.public_holidays</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>