<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="nhr_regions_view_list" model="ir.ui.view">
        <field name="name">nhr.regions.list</field>
        <field name="model">nhr.regions</field>
        <field name="arch" type="xml">
            <list string="Property Tags">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="nhr_regions_view_form" model="ir.ui.view">
        <field name="name">nhr.regions.form</field>
        <field name="model">nhr.regions</field>
        <field name="arch" type="xml">
            <form string="Property Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="nhr_regions_action" model="ir.actions.act_window">
        <field name="name">Regions</field>
        <field name="res_model">nhr.regions</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>