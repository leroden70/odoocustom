<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="newhr_locations_view_list" model="ir.ui.view">
        <field name="name">newhr.locations.list</field>
        <field name="model">newhr.locations</field>
        <field name="arch" type="xml">
            <list string="Locations">
                <field name="street_address"/>
                <field name="postal_code"/>
                <field name="city"/>
                <field name="state_province"/>
                <field name="country_id"/>
            </list>
        </field>
    </record>
    <record id="newhr_locations_view_form" model="ir.ui.view">
        <field name="name">newhr.locations.form</field>
        <field name="model">newhr.locations</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <group>
                        <field name="street_address"/>
                        <field name="postal_code"/>
                        <field name="city"/>
                        <field name="state_province"/>
                        <field name="country_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="newhr_locations_action" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">newhr.locations</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>